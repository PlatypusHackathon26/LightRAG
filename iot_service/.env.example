# ==============================================================================
# CẤU HÌNH HỆ THỐNG IOT GIÁM SÁT BỆ THỬ MÁY NÉN DENSO
# ==============================================================================

# Khóa xác thực API Tool dành cho Agent và người vận hành
IOT_API_KEY=test-api-key-denso-2026
IOT_ADMIN_KEY=test-admin-key-denso-2026

# Cấu hình MQTT Broker (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883

# Chuỗi kết nối TimescaleDB (PostgreSQL port 5433 trên host, mặc định database denso_iot)
DB_DSN=postgresql://postgres:postgres@localhost:5433/denso_iot

# Cổng chạy ứng dụng FastAPI (IoT & Gateway service)
GATEWAY_PORT=9700

# Tần suất phát metric từ Simulator lên MQTT (giây)
PUBLISH_INTERVAL_S=5

# Hệ số gia tốc thời gian mô phỏng (1 = thời gian thực, >1 để tăng tốc kiểm thử)
SIM_SPEEDUP=1

# Cửa sổ chống lặp / khử trùng sự kiện lỗi lặp lại (giây)
DEDUP_WINDOW_S=600

# Thời gian sống của thẻ hành động đề xuất trước khi hết hạn (giây, Giai đoạn 2)
ACTION_TTL_S=60

# Chế độ tự chủ của Agent: advisory | hitl | auto_safe (Giai đoạn 2)
AUTONOMY_MODE=hitl

# Công tắc dừng khẩn cấp tính năng tự động của Agent (true | false)
AGENT_ENABLED=true

# Chế độ Agent hoạt động: rules | llm | hybrid (Giai đoạn 2)
AGENT_MODE=rules

# Cấu hình LLM cho Agent phân tích nguyên nhân (Giai đoạn 2)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dummy-llm-key
LLM_MODEL=gpt-4o-mini

# Cấu hình LightRAG Server để tra cứu tài liệu DENSO (Giai đoạn 2)
RAG_BASE_URL=http://localhost:9621
RAG_API_KEY=dummy-rag-key
RAG_MODE=auto
