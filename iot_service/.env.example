# ==============================================================================
# CẤU HÌNH HỆ THỐNG IOT GIÁM SÁT BỆ THỬ MÁY NÉN DENSO
# ==============================================================================

# Khóa xác thực API Tool dành cho Agent và người vận hành
IOT_API_KEY=test-api-key-denso-2026
IOT_ADMIN_KEY=test-admin-key-denso-2026

# Cấu hình MQTT Broker (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883

# Chuỗi kết nối TimescaleDB (PostgreSQL port 5433 trên host, mặc định database denso_iot)
DB_DSN=postgresql://postgres:postgres@127.0.0.1:5433/denso_iot

# Cổng chạy IoT service. Chỉ nghe trên máy (các route /agent/* không có xác thực);
# giao diện đi qua DENSO Agent Gateway :9700, gateway chuyển tiếp sự cố / telemetry / lệnh sang đây.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9710

# Tần suất phát metric từ Simulator lên MQTT (giây)
PUBLISH_INTERVAL_S=5

# Hệ số gia tốc thời gian mô phỏng (1 = thời gian thực, >1 để tăng tốc kiểm thử)
SIM_SPEEDUP=1

# Cửa sổ chống lặp / khử trùng sự kiện lỗi lặp lại (giây)
DEDUP_WINDOW_S=600

# Khóa xác thực chỉ đọc cho Dashboard giám sát (nếu để trống: mở trong mạng nội bộ)
DASHBOARD_TOKEN=

# Số lượng kết nối SSE Dashboard đồng thời tối đa
SSE_MAX_CLIENTS=50

# Địa chỉ WebUI Agent Copilot (để tạo liên kết từ Dashboard sang WebUI duyệt lệnh HITL)
WEBUI_URL=http://localhost:5173

# Thời gian sống của thẻ hành động đề xuất trước khi hết hạn (giây, Giai đoạn 2)
ACTION_TTL_S=60

# Chế độ tự chủ của Agent: advisory | hitl | auto_safe (Giai đoạn 2)
AUTONOMY_MODE=hitl

# Công tắc dừng khẩn cấp tính năng tự động của Agent (true | false)
AGENT_ENABLED=true

# Chế độ Agent hoạt động: rules | llm | hybrid (Giai đoạn 2)
AGENT_MODE=rules

# Cấu hình LLM cho Agent phân tích nguyên nhân (Giai đoạn 2). Trên laptop 16 GB KHÔNG dùng Ollama
# (máy đã tắt đột ngột khi chạy LLM cục bộ): trỏ sang proxy NVIDIA của denso, ví dụ
#   LLM_BASE_URL=http://127.0.0.1:8899/v1   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dummy-llm-key
LLM_MODEL=gpt-4o-mini

# Cấu hình LightRAG Server để tra cứu tài liệu DENSO (Giai đoạn 2)
RAG_BASE_URL=http://localhost:9621
RAG_API_KEY=dummy-rag-key
RAG_MODE=auto
# Tra cứu qua DENSO Agent Gateway (phân quyền, ngôn ngữ, trích dẫn theo trang). Để trống = gọi LightRAG trực tiếp.
RAG_GATEWAY_URL=http://127.0.0.1:9700
# Token trong denso/gateway/users.json; để trống = khách (cấp 1)
RAG_GATEWAY_TOKEN=
RAG_TIMEOUT_S=90
