### DENSO local-stack overrides for LightRAG (.env is gitignored, this file is not).
### Setup:  copy env.example .env ; then append this file to .env
###   PowerShell:  Get-Content denso\env.denso | Add-Content .env
### python-dotenv keeps the LAST occurrence of a key, so appended values win.

### Server: localhost only - the documents are confidential
HOST=127.0.0.1

### LLM: local Ollama
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_BINDING_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=900
MAX_ASYNC_LLM=1
OLLAMA_LLM_NUM_CTX=32768
OLLAMA_LLM_THINK=false
### REQUIRED: LightRAG's Ollama default num_predict is 128 tokens, which cuts the
### entity-extraction JSON off after ~2 entities ("JSON extraction result is
### empty or unrecoverable"). One 2000-token chunk needs ~3500 output tokens.
OLLAMA_LLM_NUM_PREDICT=8192

### Embedding: bge-m3 via Ollama (multilingual, 1024-dim)
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_BINDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_FUNC_MAX_ASYNC=2
OLLAMA_EMBEDDING_NUM_CTX=8192

### 16 GB laptop: one document at a time
MAX_PARALLEL_INSERT=1

### Parsing. The denso pipeline uploads cleaned Markdown (native engine, heading-aware
### P chunking); raw PDFs/images uploaded directly still go to the local docling-serve.
LIGHTRAG_PARSER=pdf:docling-P,pptx:docling-P,xlsx:docling-P,png:docling-P,jpg:docling-P,jpeg:docling-P,*:native-P,*:legacy-R
DOCLING_ENDPOINT=http://localhost:5001
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=false
DOCLING_MAX_POLLS=720

### DENSO entity types (denso/prompts/entity_type/denso.yml). Set BEFORE the first
### ingest: changing the entity profile later means re-indexing everything.
PROMPT_DIR=./denso/prompts
ENTITY_TYPE_PROMPT_FILE=denso.yml

### ---- OPTIONAL: index PUBLIC documents through a free-tier API (Cerebras) ----
### Never use a free tier for confidential (level 2/3) documents: free tiers may use
### submitted content to improve their products. Query/keyword stay on local qwen3.
### Start the rate-limit proxy first:  python denso/tools/llm_rate_proxy.py
### and put the key in .env only:      EXTRACT_LLM_BINDING_API_KEY=csk-...
# EXTRACT_LLM_BINDING=openai
# EXTRACT_LLM_BINDING_HOST=http://127.0.0.1:8899/v1
# EXTRACT_LLM_MODEL=gpt-oss-120b
# EXTRACT_LLM_TIMEOUT=900
# EXTRACT_MAX_ASYNC_LLM=2
# EXTRACT_OPENAI_LLM_REASONING_EFFORT=low
# EXTRACT_OPENAI_LLM_MAX_COMPLETION_TOKENS=8192
# QUERY_MAX_ASYNC_LLM=1
# KEYWORD_MAX_ASYNC_LLM=1
# MAX_ASYNC_LLM=2
# MAX_PARALLEL_INSERT=2
# MAX_GLEANING=0

### Access levels = one LightRAG server per workspace (the LIGHTRAG-WORKSPACE header
### does not select storage). Start each with its own env, e.g. in PowerShell:
###   $env:WORKSPACE="level_1"; $env:PORT="9621"; .venv\Scripts\lightrag-server.exe

### ---- OPTIONAL: answer queries through the same free-tier API (benchmarking) ----
### Same model for every mode so comparisons are fair; start the proxy with
### --fallback-model "" so it stops instead of switching models mid-run.
### The proxy injects the real key, LightRAG only needs a placeholder per role.
# QUERY_LLM_BINDING=openai
# QUERY_LLM_BINDING_HOST=http://127.0.0.1:8899/v1
# QUERY_LLM_MODEL=gpt-oss-120b
# QUERY_LLM_BINDING_API_KEY=via-proxy
# QUERY_OPENAI_LLM_REASONING_EFFORT=low
# QUERY_OPENAI_LLM_MAX_COMPLETION_TOKENS=4096
# KEYWORD_LLM_BINDING=openai
# KEYWORD_LLM_BINDING_HOST=http://127.0.0.1:8899/v1
# KEYWORD_LLM_MODEL=gpt-oss-120b
# KEYWORD_LLM_BINDING_API_KEY=via-proxy
# KEYWORD_OPENAI_LLM_REASONING_EFFORT=low
# KEYWORD_OPENAI_LLM_MAX_COMPLETION_TOKENS=2048
### ~14K tokens per question (default 20 chunks / 30K tokens is ~25-30K):
# CHUNK_TOP_K=10
# MAX_TOTAL_TOKENS=16000
### On Windows, start lightrag-server with PYTHONIOENCODING=utf-8 when its output
### is redirected, or the Unicode start-up banner crashes it (cp1252).

### With MAX_TOTAL_TOKENS=16000 the default entity/relation budgets (6000 + 8000)
### leave mix almost no text chunks; scale them down with the total:
# MAX_ENTITY_TOKENS=3000
# MAX_RELATION_TOKENS=4000
### Answer instructions (denso/prompts/user_prompt/denso_answer.md): on by default since the 2026-10-07 benchmark (naive 95% -> 100%).
USER_PROMPT_PREFIX_FILE=denso_answer.md

### Deterministic answers (default 1.0 made the same question flip between right and wrong):
QUERY_OPENAI_LLM_TEMPERATURE=0
KEYWORD_OPENAI_LLM_TEMPERATURE=0

### Language-preference reranker (denso/tools/lang_rerank.py, start it first:
### python denso/tools/lang_rerank.py). Chunks in the question's language move
### to the front, except for questions about another language. CHUNK_TOP_K is
### the candidate pool it re-orders; MAX_TOTAL_TOKENS still decides how many
### chunks reach the LLM. If the service is down LightRAG keeps the vector order.
### Benchmarks comparable with the no-rerank baseline: run_benchmark.py --no-rerank.
# RERANK_BINDING=cohere
# RERANK_MODEL=denso-lang-pref
# RERANK_BINDING_HOST=http://127.0.0.1:7998/rerank
# CHUNK_TOP_K=30
