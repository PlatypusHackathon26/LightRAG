### Container-side settings for denso/docker-compose.yml.
### Copy to denso/compose.env (gitignored). It is loaded AFTER the host .env, so it only
### overrides what differs inside containers (service hostnames, container paths).
### The host .env stays usable for a plain `lightrag-server` run (AGENTS.md rule).

### Paths inside the LightRAG containers (volumes are mounted by the compose file)
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts
HOST=0.0.0.0
PORT=9621

### Parsing: the docling container (profile "parse")
DOCLING_ENDPOINT=http://docling:5001

### LLM + embeddings: Ollama on the HOST is the default (GPU, already has the models).
### For the bundled CPU Ollama container (profile "local-llm") use http://ollama:11434.
LLM_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434

### Free-tier API roles through the rate proxy container (profile "proxy").
### Remove these three lines to keep every role on Ollama.
EXTRACT_LLM_BINDING_HOST=http://proxy:8899/v1
QUERY_LLM_BINDING_HOST=http://proxy:8899/v1
KEYWORD_LLM_BINDING_HOST=http://proxy:8899/v1

### Reranker container (profile "rerank"); leave RERANK_BINDING=null in .env to disable.
# RERANK_BINDING=cohere
# RERANK_BINDING_HOST=http://reranker:7997/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
