# LightRAG WebUI Environment Variables Template
VITE_BACKEND_URL=http://localhost:9621
VITE_GATEWAY_URL=http://localhost:9700
VITE_API_PROXY=true
VITE_API_ENDPOINTS=/api,/documents,/graphs,/graph,/health,/query,/docs,/redoc,/openapi.json,/login,/auth-status,/auth/verify,/ui/customization,/static

# Industrial Agentic Copilot: true shows the agentic workspace instead of the LightRAG UI.
VITE_DEMO_MODE=true

# Agent backend (src/features/agentic/agentConfig.ts):
# false = canned mock incidents, telemetry and answers (no backend needed)
# true  = DENSO Agent Gateway at VITE_AGENT_BASE_URL (chat, documents, incidents, HITL)
VITE_AGENT_LIVE=false
VITE_AGENT_BASE_URL=http://127.0.0.1:9700
